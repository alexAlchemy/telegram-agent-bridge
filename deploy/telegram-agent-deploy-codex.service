[Unit]
Description=Validate and deploy the Codex Telegram agent bridge
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/deploy-telegram-agent-codex
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/alex/codex-telegram-bridge
ReadWritePaths=/usr/local/lib/codex-telegram-bridge /run
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
StandardOutput=journal
StandardError=journal
