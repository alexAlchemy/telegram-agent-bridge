# Install as /etc/codex-telegram-bridge.env owned by root:root with mode 0600.
# Enter the BotFather token directly on the VPS. Never paste it into chat or logs.
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_ALLOWED_USER_ID=replace-with-telegram-user-id
LOG_LEVEL=INFO
# Agent home directory: the workspace and the home the CLIs run as.
# Defaults to $HOME when unset. Set it here rather than in the repo.
# BRIDGE_HOME=/path/to/agent/home
