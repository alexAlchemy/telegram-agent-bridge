# Install separately as /etc/telegram-agent/codex.env or grok.env.
# Keep root:root mode 0600 and never paste the bot token into chat.
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_ALLOWED_USER_ID=replace-with-telegram-user-id
LOG_LEVEL=INFO
AGENT_TIMEOUT_SECONDS=1800

# Optional per-backend settings:
# GROK_MAX_TURNS=100
# BRIDGE_STATE_PATH=/var/lib/telegram-agent/grok/state.sqlite3
# BRIDGE_UPLOAD_ROOT=/home/alex/.cache/telegram-agent-bridge/grok/uploads
