[Unit]
Description=Private Telegram to Codex CLI Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=alex
Group=alex
WorkingDirectory=/home/alex
Environment=HOME=/home/alex
Environment=USER=alex
Environment=LOGNAME=alex
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/home/alex/.local/bin
EnvironmentFile=/etc/codex-telegram-bridge.env
ExecStart=/usr/bin/python3 /usr/local/lib/codex-telegram-bridge/bridge.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=mixed
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/alex /var/lib/codex-telegram-bridge
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
MemoryMax=4G
TasksMax=256

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
