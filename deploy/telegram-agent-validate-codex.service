[Unit]
Description=Validate the Codex Telegram agent bridge as alex
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/validate-telegram-agent-codex
User=alex
Group=alex
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/alex/codex-telegram-bridge
ReadWritePaths=/home/alex/.codex/generated_images
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
StandardOutput=journal
StandardError=journal
